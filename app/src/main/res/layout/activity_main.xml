<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ticktock_white"
    android:padding="12dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="TickTock"
            android:textAlignment="center"
            android:textColor="@color/ticktock_blue"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/guessLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Initial guess period [ms]"
            android:textColor="@color/ticktock_blue"
            android:textAlignment="center"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titleText" />

        <EditText
            android:id="@+id/guessInput"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/border_box"
            android:ems="6"
            android:gravity="center"
            android:inputType="number"
            android:text="1200"
            android:textColor="@color/ticktock_blue"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/guessLabel" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="0dp"
            android:layout_height="73dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/ticktock_blue"
            android:text="Start"
            android:gravity="center"
            android:textColor="@color/ticktock_white"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/guessInput" />

        <com.ticktock.app.GaugeView
            android:id="@+id/gaugeView"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/startButton" />

        <TextView
            android:id="@+id/asymmetryPercentText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/metric_box"
            android:padding="8dp"
            android:text="Asymmetry [%]\n--"
            android:textAlignment="center"
            android:textColor="@color/ticktock_blue"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/gaugeView" />

        <TextView
            android:id="@+id/asymmetryMsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/metric_box"
            android:padding="8dp"
            android:text="Asymmetry [ms]\n--"
            android:textAlignment="center"
            android:textColor="@color/ticktock_blue"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/asymmetryPercentText" />

        <TextView
            android:id="@+id/periodText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/metric_box"
            android:padding="8dp"
            android:text="Period [ms]\n--"
            android:textAlignment="center"
            android:textColor="@color/ticktock_blue"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/asymmetryMsText" />

        <LinearLayout
            android:id="@+id/beatRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/periodText">

            <View
                android:id="@+id/beatDot"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/dot_shape"
                android:backgroundTint="@color/ticktock_red" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Searching beat..."
                android:textColor="@color/ticktock_blue"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/footerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:text="Android app for setting the beat on a pendulum clock"
            android:textAlignment="center"
            android:textColor="@color/ticktock_blue"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/beatRow" />
</androidx.constraintlayout.widget.ConstraintLayout>
